pipeline {

    agent { label 'docker' }

    

    stages {
        
        stage('Checkout') {
            steps {
                checkout scm
            }
        }
        
        stage('Check Changed Files') {
            steps {
                script {

                    def changedFiles = sh(
                    script: "git diff --name-only HEAD~1 HEAD",
                    returnStdout: true
                ).trim()

            echo "Changed files:"
            echo changedFiles

            def infraChanged = false

            changedFiles.split("\n").each { file ->
                if (file.startsWith("k8s/")) {
                    infraChanged = true
                }
            }

            if (!infraChanged) {
                currentBuild.result = 'SUCCESS'
                error("No infrastructure changes detected. Skipping Infrastructure Pipeline.")
            }
        }
    }
}
        

        stage('Validate Kubernetes YAML') {
            steps {
                sh '''
                kubectl apply --dry-run=client -f k8s/
                '''
            }
        }

    }

    post {
        success {
            echo 'Infrastructure validation successful.'
        }

        failure {
            echo 'Infrastructure validation failed.'
        }
    }
}
